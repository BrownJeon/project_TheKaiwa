}

enum HealthKind {
  HEALTH
  FUNCTIONAL
}

/// ConfigurationVersion·RuntimeOverride·AuditLog 의 대상 범위
enum ConfigScope {
  ENGINE_CONNECTION
  FALLBACK_POLICY
