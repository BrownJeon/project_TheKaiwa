enum Environment {
  LOCAL
  DEVELOPMENT
  STAGING
  PRODUCTION
}

enum JlptLevel {
  N5
  N4
  N3
  N2
  N1
}

/// 조각: 이름·액션·느낌·꾸밈 (레퍼런스1)
enum ChunkType {
  NAME
  ACTION
  FEELING
  MODIFIER
}

enum PartOfSpeech {
  NOUN
  VERB
  ADJ_I
  ADJ_NA
  ADVERB
  PARTICLE
  EXPRESSION
  OTHER
}

enum WordSource {
  MANUAL
  CORRECTION
  LESSON
  EVALUATION
  TUTOR
  SEED
}

