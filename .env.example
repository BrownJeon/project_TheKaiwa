# TheKaiwa — 환경 변수 예시 (값은 절대 커밋하지 않는다. 운영은 apps/thekaiwa/shared/.env)
# ── 앱 ──
APP_ENV=LOCAL                      # LOCAL | PRODUCTION (STAGING/DEVELOPMENT 은 슬롯)
PORT=3010
NODE_ENV=development
DATA_ROOT=/home/brownjeon/NFS/homes/brownjeon/project/files/thekaiwa   # TheMeal 관례(NFS files/). 발화 wav·TTS 캐시·APK 배포본 (소스 트리 밖)

# ── DB (NAS MariaDB, utf8mb4) ──
DATABASE_URL=mysql://thekaiwa:CHANGE_ME@192.168.219.154:3306/thekaiwa

# ── 인증 (TheMeal 방식) ──
JWT_SECRET=CHANGE_ME_32_BYTES_MIN
JWT_EXPIRES=30d
SIGNUP_INVITE_CODE=CHANGE_ME
OWNER_EMAIL=you@example.com        # 시드에서 SUPER_ADMIN
OWNER_NAME=Owner
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_CALLBACK_BASE=https://kaiwa.xn--lh0b87pnudm10a4vd.com
APP_DEEP_LINK_SCHEME=thekaiwa

# ── LLM (Claude CLI 구독이 기본, home-m4 는 어댑터) ──
CLAUDE_CLI_PATH=claude
CLAUDE_CLI_CONCURRENCY=1
AI_API_BASE=http://192.168.219.100:8000     # home-m4-api (보조)
AI_API_KEY_REF=env:HOME_M4_API_KEY          # credentialRef — 값은 HOME_M4_API_KEY 에
HOME_M4_API_KEY=
AI_API_MODEL=qwen2.5:14b-instruct

# ── 음성 서비스 ──
SPEECH_GATEWAY_URL=http://127.0.0.1:8100
SPEECH_INTERNAL_SECRET=CHANGE_ME             # gateway/worker → /api/internal/* 헤더 X-Internal-Secret
SPEECH_CONFIG_PATH=./speech/speech.config.yml
TTS_SERVICE_URL=http://192.168.219.100:8200  # 맥 M4 Style-Bert-VITS2 래퍼
WHISPER_SERVICE_URL=http://127.0.0.1:8090     # VoiceVault whisper-service 재사용
SECRETS_DIR=/home/brownjeon/apps/thekaiwa/shared/secrets   # credentialRef file:<name>

# ── 앱 배포본 ──
APK_DOWNLOAD_BASE=https://kaiwa.xn--lh0b87pnudm10a4vd.com/app/download
