<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ : 클라우드 백업·기기 간 이전 모두에서 앱 데이터(세션 쿠키·인식 파일·발화 wav)를 뺀다. AndroidManifest 주석 참고. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
